# Copy to src/.env for local development (the app reads .env from its working
# directory, which is src/). In k8s the same variables come from the Deployment.

# Keycloak as the browser sees it: the SPA logs in here, and access tokens must
# carry this issuer.
KC_PUBLIC_URL=https://staging.id.scouterna.se
# Keycloak as the backend sees it (JWKS, Admin API). Locally, port-forward the
# in-cluster Service:
#   kubectl -n proj-scoutid-staging port-forward svc/scoutid-keycloak 8081:8080
KC_INTERNAL_URL=http://localhost:8081
KC_REALM=scoutid
KC_CLIENT_ID=scoutid-admin-gui

# Permissions from the Scoutnet memberships claim (these are the defaults).
#ADMIN_ORG_ID=692
#ADMIN_ROLE_ID=235
#GROUP_MANAGER_ROLE_ID=136
#ADMIN_CLIENT_ROLE=

#PORT=8080
#DEBUG=false
