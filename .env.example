# Copy to src/.env for local development (the app reads .env from its working
# directory, which is src/). In k8s the same variables come from the Deployment.

# Where the GUI is reached. With `pnpm dev`, that is the Vite dev server, which
# proxies /api and /auth to this backend.
PUBLIC_URL=http://localhost:5173
INSECURE_COOKIES=true

# Keycloak as the browser sees it (issuer base, login redirects).
KC_PUBLIC_URL=https://staging.id.scouterna.se
# Keycloak as the backend sees it (token endpoint, JWKS, Admin API). Locally,
# port-forward the in-cluster Service:
#   kubectl --kubeconfig ~/.kube/config.wsv2 -n proj-scoutid-staging port-forward svc/scoutid-keycloak 8081:8080
KC_INTERNAL_URL=http://localhost:8081
KC_REALM=scoutid
KC_CLIENT_ID=scoutid-admin-gui
KC_CLIENT_SECRET=change-me

# Permissions from the Scoutnet memberships claim (these are the defaults).
#ADMIN_ORG_ID=692
#ADMIN_ROLE_ID=235
#GROUP_MANAGER_ROLE_ID=136
#ADMIN_CLIENT_ROLE=

# Dev only: skip Keycloak login and sign in as these claims.
#FAKE_USER_CLAIMS={"sub":"fake","preferred_username":"1234567@scoutnet","name":"Test Testsson","memberships":{"groups":{"784":{"name":"Trollbäckens Scoutkår","roles":[{"id":136,"key":"it_manager"}]}}}}

#PORT=8080
#DEBUG=false
